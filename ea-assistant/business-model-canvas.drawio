          <mxGeometry x="670" y="45" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;i&gt;What relationship does each segment expect?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Personal assistance&lt;br/&gt;&#x2022; Self-service&lt;br/&gt;&#x2022; Automated services&lt;br/&gt;&#x2022; Communities&lt;br/&gt;&#x2022; Co-creation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="11">
