        </mxCell>
        <mxCell id="20" value="&lt;i&gt;For what value are our customers willing to pay?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Asset sale &amp;nbsp;&#x2022; Usage fee &amp;nbsp;&#x2022; Subscription fees &amp;nbsp;&#x2022; Lending / Renting / Leasing&lt;br/&gt;&#x2022; Licensing &amp;nbsp;&#x2022; Brokerage fees &amp;nbsp;&#x2022; Advertising" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="19">
