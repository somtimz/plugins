          <mxGeometry x="670" y="245" width="210" height="185" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;i&gt;How do we reach our customer segments?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Awareness&lt;br/&gt;&#x2022; Evaluation&lt;br/&gt;&#x2022; Purchase&lt;br/&gt;&#x2022; Delivery&lt;br/&gt;&#x2022; After sales" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="13">
