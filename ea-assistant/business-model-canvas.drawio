          <mxGeometry x="890" y="45" width="210" height="385" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;i&gt;For whom are we creating value?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Mass market&lt;br/&gt;&#x2022; Niche market&lt;br/&gt;&#x2022; Segmented&lt;br/&gt;&#x2022; Diversified&lt;br/&gt;&#x2022; Multi-sided platform" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="15">
