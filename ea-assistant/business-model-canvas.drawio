  <diagram name="Business Model Canvas">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="2" value="Business Model Canvas" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="0" width="1090" height="35" as="geometry" />
        </mxCell>

        <!-- Key Partners (col 1, spans both rows) -->
        <mxCell id="3" value="Key Partners" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="45" width="210" height="385" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;i&gt;Who are our key partners and suppliers?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Strategic alliances&lt;br/&gt;&#x2022; Joint ventures&lt;br/&gt;&#x2022; Buyer-supplier relationships&lt;br/&gt;&#x2022; Key resource acquirers&lt;br/&gt;&#x2022; Key activity performers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="3">
          <mxGeometry x="0" y="30" width="210" height="355" as="geometry" />
        </mxCell>

        <!-- Key Activities (col 2, top row) -->
        <mxCell id="5" value="Key Activities" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="45" width="210" height="190" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;i&gt;What key activities does our value proposition require?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Production&lt;br/&gt;&#x2022; Problem solving&lt;br/&gt;&#x2022; Platform / network" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="5">
