          <mxGeometry x="10" y="440" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;i&gt;What are the most important costs in our business model?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Cost-driven &amp;nbsp;&#x2022; Value-driven &amp;nbsp;&#x2022; Fixed costs &amp;nbsp;&#x2022; Variable costs&lt;br/&gt;&#x2022; Economies of scale &amp;nbsp;&#x2022; Economies of scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="17">
