          <mxGeometry x="230" y="245" width="210" height="185" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;i&gt;What key resources does our value proposition require?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Physical&lt;br/&gt;&#x2022; Intellectual&lt;br/&gt;&#x2022; Human&lt;br/&gt;&#x2022; Financial" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="7">
          <mxGeometry x="0" y="30" width="210" height="155" as="geometry" />
        </mxCell>

        <!-- Value Propositions (col 3, spans both rows) -->
