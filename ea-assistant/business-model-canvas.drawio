          <mxGeometry x="450" y="45" width="210" height="385" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;i&gt;What value do we deliver to the customer?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&#x2022; Newness&lt;br/&gt;&#x2022; Performance&lt;br/&gt;&#x2022; Customisation&lt;br/&gt;&#x2022; Getting the job done&lt;br/&gt;&#x2022; Design&lt;br/&gt;&#x2022; Brand / status&lt;br/&gt;&#x2022; Price&lt;br/&gt;&#x2022; Cost reduction&lt;br/&gt;&#x2022; Risk reduction&lt;br/&gt;&#x2022; Accessibility&lt;br/&gt;&#x2022; Convenience" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=6;spacingTop=6;fontSize=10;" vertex="1" parent="9">
